// PBDerp — 通用型电商 ERP
// Prisma 7 schema. Business tables carry organizationId for future multi-tenancy.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  SALES
  PURCHASER
  WAREHOUSE
  FINANCE
  VIEWER
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  COMPLETED
  CANCELLED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

enum StockMovementType {
  INITIAL
  PURCHASE_RECEIPT
  SALES_SHIPMENT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
  RETURN_IN
  RETURN_OUT
}

enum ReservationStatus {
  ACTIVE
  RELEASED
  CONSUMED
}

enum PaymentDirection {
  IN
  OUT
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ALIPAY
  WECHAT
  CARD
  OTHER
}

enum PaymentReferenceType {
  SALES_ORDER
  PURCHASE_ORDER
}

enum TransferStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

enum DocumentType {
  SALES_ORDER
  PURCHASE_ORDER
  SHIPMENT
  GOODS_RECEIPT
  STOCK_TRANSFER
}

// ---------------------------------------------------------------------------
// Organization & auth (better-auth core tables)
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  currency  String   @default("CNY")
  timezone  String   @default("Asia/Shanghai")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id             String       @id @default(cuid())
  name           String
  email          String       @unique
  emailVerified  Boolean      @default(false)
  image          String?
  role           UserRole     @default(VIEWER)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  sessions              Session[]
  accounts              Account[]
  createdSalesOrders    SalesOrder[]    @relation("SalesOrderCreatedBy")
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  stockMovements        StockMovement[] @relation("StockMovementCreatedBy")
  stockTransfers        StockTransfer[] @relation("StockTransferCreatedBy")
  payments              Payment[]       @relation("PaymentCreatedBy")
  auditLogs             AuditLog[]      @relation("AuditActor")

  @@index([organizationId])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Master data
// ---------------------------------------------------------------------------

model Category {
  id             String       @id @default(cuid())
  organizationId String
  parentId       String?
  parent         Category?    @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children       Category[]   @relation("CategoryTree")
  name           String
  code           String
  sort           Int          @default(0)
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products Product[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId])
}

model Brand {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products Product[]

  @@unique([organizationId, code])
}

model Unit {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  code           String
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  products Product[]

  @@unique([organizationId, code])
}

model Product {
  id             String        @id @default(cuid())
  organizationId String
  code           String
  name           String
  categoryId     String?
  category       Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brandId        String?
  brand          Brand?        @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unitId         String?
  unit           Unit?         @relation(fields: [unitId], references: [id], onDelete: SetNull)
  status         ProductStatus @default(ACTIVE)
  description    String?
  imageUrl       String?
  tags           String[]      @default([])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  variants ProductVariant[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, categoryId])
}

model ProductVariant {
  id             String       @id @default(cuid())
  organizationId String
  productId      String
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String
  barcode        String?
  name           String
  spec           Json?
  purchasePrice  Decimal      @default(0) @db.Decimal(18, 4)
  salePrice      Decimal      @default(0) @db.Decimal(18, 4)
  reorderPoint   Decimal      @default(0) @db.Decimal(18, 4)
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  reservations       StockReservation[]
  salesOrderLines    SalesOrderLine[]
  purchaseOrderLines PurchaseOrderLine[]
  shipmentLines      ShipmentLine[]
  goodsReceiptLines  GoodsReceiptLine[]
  stockTransferLines StockTransferLine[]

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([productId])
}

model Warehouse {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  address        String?
  isDefault      Boolean      @default(false)
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  locations      WarehouseLocation[]
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  reservations   StockReservation[]
  salesOrders    SalesOrder[]
  purchaseOrders PurchaseOrder[]
  shipments      Shipment[]
  goodsReceipts  GoodsReceipt[]
  transfersFrom  StockTransfer[]     @relation("TransferFrom")
  transfersTo    StockTransfer[]     @relation("TransferTo")

  @@unique([organizationId, code])
}

model WarehouseLocation {
  id             String       @id @default(cuid())
  organizationId String
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code           String
  name           String
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  reservations   StockReservation[]

  @@unique([warehouseId, code])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  contact        String?
  phone          String?
  email          String?
  address        String?
  taxNo          String?
  creditLimit    Decimal      @default(0) @db.Decimal(18, 2)
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  salesOrders SalesOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  contact        String?
  phone          String?
  email          String?
  address        String?
  taxNo          String?
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
}

// ---------------------------------------------------------------------------
// Inventory ledger
// ---------------------------------------------------------------------------

model StockLevel {
  id               String            @id @default(cuid())
  organizationId   String
  warehouseId      String
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId       String
  location         WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  variantId        String
  variant          ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity         Decimal           @default(0) @db.Decimal(18, 4)
  reservedQuantity Decimal           @default(0) @db.Decimal(18, 4)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([warehouseId, locationId, variantId])
  @@index([organizationId, variantId])
  @@index([organizationId, warehouseId])
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  warehouseId    String
  warehouse      Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId     String
  location       WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  type           StockMovementType
  quantity       Decimal           @db.Decimal(18, 4)
  unitCost       Decimal           @default(0) @db.Decimal(18, 4)
  balanceAfter   Decimal           @db.Decimal(18, 4)
  referenceType  String?
  referenceId    String?
  note           String?
  createdById    String?
  createdBy      User?             @relation("StockMovementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime          @default(now())

  @@index([organizationId, variantId, createdAt])
  @@index([organizationId, warehouseId, createdAt])
  @@index([organizationId, referenceType, referenceId])
}

model StockReservation {
  id               String            @id @default(cuid())
  organizationId   String
  salesOrderLineId String
  salesOrderLine   SalesOrderLine    @relation(fields: [salesOrderLineId], references: [id], onDelete: Cascade)
  warehouseId      String
  warehouse        Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  locationId       String
  location         WarehouseLocation @relation(fields: [locationId], references: [id], onDelete: Restrict)
  variantId        String
  variant          ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity         Decimal           @db.Decimal(18, 4)
  status           ReservationStatus @default(ACTIVE)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([organizationId, status])
  @@index([salesOrderLineId])
}

model StockTransfer {
  id              String         @id @default(cuid())
  organizationId  String
  transferNo      String
  fromWarehouseId String
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId   String
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  status          TransferStatus @default(DRAFT)
  note            String?
  completedAt     DateTime?
  createdById     String?
  createdBy       User?          @relation("StockTransferCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  lines StockTransferLine[]

  @@unique([organizationId, transferNo])
  @@index([organizationId, status, createdAt])
}

model StockTransferLine {
  id             String         @id @default(cuid())
  organizationId String
  transferId     String
  transfer       StockTransfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity       Decimal        @db.Decimal(18, 4)

  @@index([transferId])
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model SalesOrder {
  id             String           @id @default(cuid())
  organizationId String
  orderNo        String
  customerId     String
  customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status         SalesOrderStatus @default(DRAFT)
  currency       String           @default("CNY")
  subtotal       Decimal          @default(0) @db.Decimal(18, 2)
  discountTotal  Decimal          @default(0) @db.Decimal(18, 2)
  taxTotal       Decimal          @default(0) @db.Decimal(18, 2)
  shippingFee    Decimal          @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal          @default(0) @db.Decimal(18, 2)
  paidAmount     Decimal          @default(0) @db.Decimal(18, 2)
  paymentStatus  PaymentStatus    @default(UNPAID)
  orderedAt      DateTime         @default(now())
  confirmedAt    DateTime?
  shippedAt      DateTime?
  completedAt    DateTime?
  note           String?
  createdById    String?
  createdBy      User?            @relation("SalesOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  lines     SalesOrderLine[]
  shipments Shipment[]

  @@unique([organizationId, orderNo])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])
}

model SalesOrderLine {
  id              String         @id @default(cuid())
  organizationId  String
  orderId         String
  order           SalesOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  skuSnapshot     String
  nameSnapshot    String
  quantity        Decimal        @db.Decimal(18, 4)
  unitPrice       Decimal        @db.Decimal(18, 4)
  discount        Decimal        @default(0) @db.Decimal(18, 2)
  taxRate         Decimal        @default(0) @db.Decimal(8, 4)
  lineTotal       Decimal        @db.Decimal(18, 2)
  shippedQuantity Decimal        @default(0) @db.Decimal(18, 4)

  reservations  StockReservation[]
  shipmentLines ShipmentLine[]

  @@index([orderId])
  @@index([variantId])
}

model Shipment {
  id             String     @id @default(cuid())
  organizationId String
  shipmentNo     String
  orderId        String
  order          SalesOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse  @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  carrier        String?
  trackingNo     String?
  status         String     @default("SHIPPED")
  shippedAt      DateTime   @default(now())
  note           String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  lines ShipmentLine[]

  @@unique([organizationId, shipmentNo])
  @@index([organizationId, orderId])
}

model ShipmentLine {
  id             String         @id @default(cuid())
  organizationId String
  shipmentId     String
  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderLineId    String
  orderLine      SalesOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity       Decimal        @db.Decimal(18, 4)

  @@index([shipmentId])
}

// ---------------------------------------------------------------------------
// Purchasing
// ---------------------------------------------------------------------------

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  orderNo        String
  supplierId     String
  supplier       Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status         PurchaseOrderStatus @default(DRAFT)
  currency       String              @default("CNY")
  subtotal       Decimal             @default(0) @db.Decimal(18, 2)
  taxTotal       Decimal             @default(0) @db.Decimal(18, 2)
  grandTotal     Decimal             @default(0) @db.Decimal(18, 2)
  paidAmount     Decimal             @default(0) @db.Decimal(18, 2)
  paymentStatus  PaymentStatus       @default(UNPAID)
  expectedAt     DateTime?
  approvedAt     DateTime?
  receivedAt     DateTime?
  note           String?
  createdById    String?
  createdBy      User?               @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  lines    PurchaseOrderLine[]
  receipts GoodsReceipt[]

  @@unique([organizationId, orderNo])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, supplierId])
}

model PurchaseOrderLine {
  id               String         @id @default(cuid())
  organizationId   String
  orderId          String
  order            PurchaseOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId        String
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  skuSnapshot      String
  nameSnapshot     String
  quantity         Decimal        @db.Decimal(18, 4)
  unitCost         Decimal        @db.Decimal(18, 4)
  taxRate          Decimal        @default(0) @db.Decimal(8, 4)
  lineTotal        Decimal        @db.Decimal(18, 2)
  receivedQuantity Decimal        @default(0) @db.Decimal(18, 4)

  receiptLines GoodsReceiptLine[]

  @@index([orderId])
  @@index([variantId])
}

model GoodsReceipt {
  id             String        @id @default(cuid())
  organizationId String
  receiptNo      String
  orderId        String
  order          PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  warehouseId    String
  warehouse      Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  status         String        @default("RECEIVED")
  receivedAt     DateTime      @default(now())
  note           String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  lines GoodsReceiptLine[]

  @@unique([organizationId, receiptNo])
  @@index([organizationId, orderId])
}

model GoodsReceiptLine {
  id             String            @id @default(cuid())
  organizationId String
  receiptId      String
  receipt        GoodsReceipt      @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderLineId    String
  orderLine      PurchaseOrderLine @relation(fields: [orderLineId], references: [id], onDelete: Restrict)
  variantId      String
  variant        ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  quantity       Decimal           @db.Decimal(18, 4)
  unitCost       Decimal           @db.Decimal(18, 4)

  @@index([receiptId])
}

// ---------------------------------------------------------------------------
// Finance (light)
// ---------------------------------------------------------------------------

model Payment {
  id             String               @id @default(cuid())
  organizationId String
  direction      PaymentDirection
  referenceType  PaymentReferenceType
  referenceId    String
  amount         Decimal              @db.Decimal(18, 2)
  currency       String               @default("CNY")
  method         PaymentMethod        @default(OTHER)
  paidAt         DateTime             @default(now())
  note           String?
  createdById    String?
  createdBy      User?                @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime             @default(now())

  @@index([organizationId, referenceType, referenceId])
  @@index([organizationId, paidAt])
}

// ---------------------------------------------------------------------------
// Platform services
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  actor          User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  entityType     String
  entityId       String
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
}

model DocumentSequence {
  id             String       @id @default(cuid())
  organizationId String
  type           DocumentType
  period         String
  prefix         String
  lastNumber     Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, type, period])
}
